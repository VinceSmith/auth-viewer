# Entra ID
TENANT_ID=your-tenant-id
REDIRECT_URI=http://localhost:8000/auth/callback

# Client App (auth-viewer-client)
CLIENT_ID=your-client-app-id

# Resource API A (auth-viewer-api-a) — middle tier
API_A_APP_ID=your-api-a-app-id
API_A_SCOPE=api://your-api-a-app-id/access_as_user
API_A_BASE_URL=http://localhost:8001

# Resource API B (auth-viewer-api-b) — downstream
API_B_APP_ID=your-api-b-app-id
API_B_SCOPE=api://your-api-b-app-id/read
API_B_BASE_URL=http://localhost:8002

# Agent ID (Blueprint + Agent Identity)
AGENT_BLUEPRINT_APP_ID=your-blueprint-app-id
AGENT_IDENTITY_ID=your-agent-identity-app-id
AGENT_IDENTITY_TENANT_ID=your-agent-identity-tenant-id

# Session
SESSION_SECRET=change-me-to-a-random-string
